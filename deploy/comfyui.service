[Unit]
Description=ComfyUI (MiniMax H3)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/path/to/ComfyUI
ExecStart=/path/to/venv/bin/python /path/to/ComfyUI/main.py \
    --use-sage-attention \
    --fast \
    --reserve-vram 1.2 \
    --preview-method latent2rgb \
    --listen 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
